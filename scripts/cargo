#!/usr/bin/env python3
"""Run a project Cargo command with a sandbox-local compiler cache when bootstrapped."""
import os
from pathlib import Path
import shutil
import sys
import tempfile

from compile_cache import UnreapedBuild, foreground_terminal, installed, open_store, run_session, sandbox_for

root = Path(__file__).resolve().parent.parent
args = sys.argv[1:]
os.environ["PATH"] = str(root / ".tools/bin") + os.pathsep + os.environ.get("PATH", "")

def validate_scratch_args(args):
    import tomllib
    cargo_args = iter(args)
    for arg in cargo_args:
        key, separator, value = arg.partition("=")
        if arg == "--":
            break
        if key in {"--target-dir", "--build-dir"}:
            sys.exit(f"--scratch-target owns Cargo's output directories; remove {key}")
        if key == "--config":
            if not separator:
                value = next(cargo_args, "")
            try:
                config = tomllib.loads(value)
            except tomllib.TOMLDecodeError:
                try:
                    with open(value, "rb") as source:
                        config = tomllib.load(source)
                except (OSError, tomllib.TOMLDecodeError):
                    continue  # Cargo diagnoses malformed or missing configurations.
            build = config.get("build", {})
            if isinstance(build, dict) and {"target-dir", "build-dir"} & build.keys():
                sys.exit("--scratch-target owns Cargo's output directories; remove the --config output override")


scratch_target = args[:1] == ["--scratch-target"]
if scratch_target:
    args = args[1:]
    validate_scratch_args(args)


def run_build(command, env, lease=None):
    if not scratch_target:
        return run_session(command, env, lease)
    parent = Path(env.get("YULIUS_BUILD_SCRATCH", root / "target"))
    parent.mkdir(exist_ok=True, parents=True)
    build = tempfile.mkdtemp(prefix="cargo-", dir=parent)
    try:
        result = run_session(command, dict(env, CARGO_TARGET_DIR=build, CARGO_BUILD_BUILD_DIR=build, CARGO_BUILD_TARGET_DIR=build), lease, disposable=True)
    except UnreapedBuild as error:
        # The containing session can reclaim this target once its processes end.
        raise UnreapedBuild(f"{error}; retained build target {build}") from error
    except BaseException:
        remove_target(build, parent)
        raise
    remove_target(build, parent)
    return result


def remove_target(build, parent):
    try:
        shutil.rmtree(build)
    except FileNotFoundError:
        if os.path.lexists(build):
            raise
        # cargo clean can remove the allocated root itself.
    except PermissionError:
        # TemporaryDirectory's cleanup also handles owner-read-only dependencies.
        with tempfile.TemporaryDirectory(prefix="cargo-clean-", dir=parent) as disposal:
            os.rename(build, Path(disposal) / "target")


def plain(cargo):
    os.environ["CARGO"] = cargo
    if scratch_target:
        status = run_build([cargo, *args], os.environ)
        sys.exit(status if status >= 0 else 128 - status)
    os.execvp(cargo, [cargo, *args])


# mbx invokes Cargo for discovery before the build. Mark the actual dispatch, so a cache
# startup error can fall back without ever retrying a test, an executable or a failed build.
marker = os.environ.pop("YULIUS_MBX_DISPATCH", None)
if marker is not None:
    os.close(int(os.environ.pop("YULIUS_MBX_LEASE")))
    if args and args[0] not in {"metadata", "locate-project", "-V", "-vV", "--version"}:
        Path(marker).touch()
        if "RUSTC_WRAPPER" in os.environ:
            os.environ["YULIUS_MBX_RUSTC"] = os.environ["RUSTC_WRAPPER"]
            os.environ["RUSTC_WRAPPER"] = str(root / "scripts/cache-rustc")
    plain(os.environ.pop("YULIUS_MBX_CARGO"))

configured = os.environ.get("CARGO") or "cargo"
cargo = shutil.which(configured) or configured
launcher = Path(__file__).resolve()
if Path(cargo).resolve() == launcher:
    # A build tool may set CARGO to this launcher, or put scripts first in PATH.
    for directory in os.get_exec_path():
        executable = shutil.which("cargo", path=directory or ".")
        if executable and Path(executable).resolve() != launcher:
            cargo = executable
            break
    else:
        sys.exit("The project Cargo launcher needs a Cargo executable on PATH")
# Yulius CI keeps the runner's session for cancellation and redirects all three streams.
unattended_ci = (os.environ.get("YULIUS_CI") == "1" and os.environ.get("YULIUS_CI_RUN")
                 and not any(os.isatty(fd) for fd in (0, 1, 2)))
if (sys.platform != "linux" or not os.environ.get("YULIUS_SANDBOX")
        or not args or args[0] not in {"build", "check", "clippy", "doc", "nextest", "run", "test"}
        or "RUSTC_WRAPPER" in os.environ or os.environ.get("CARGO_INCREMENTAL", "0") != "0"
        or sys.stdin.isatty() or (not unattended_ci and foreground_terminal())
        or any("--jobserver-" in os.environ.get(name, "") for name in ("CARGO_MAKEFLAGS", "MAKEFLAGS", "MFLAGS"))):
    plain(cargo)

import fcntl

sandbox = sandbox_for(root, Path.home().resolve())
if sandbox is None:
    plain(cargo)
# Leave explicit global or remote mbx configurations outside this repository policy.
config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
if os.environ.get("MBX_REMOTE_URL") or (config_home / "mbx/config.toml").exists():
    plain(cargo)
cache = sandbox / "rust-compile-cache"
try:
    mbx = installed(root)
    if not os.access(mbx, os.X_OK):
        plain(cargo)
    # Disk upkeep locks this same directory exclusively before reclaiming the cache. A build
    # arriving during reclamation starts immediately with plain Cargo.
    lease = os.open(sandbox, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    fcntl.flock(lease, fcntl.LOCK_SH | fcntl.LOCK_NB)
    if not open_store(cache, root):
        plain(cargo)
    with tempfile.TemporaryDirectory(prefix="yulius-cargo-") as scratch:
        marker = Path(scratch) / "dispatched"
        env = dict(os.environ, CARGO=str(root / "scripts/cargo"), YULIUS_MBX_CARGO=cargo,
                   YULIUS_MBX_DISPATCH=str(marker), YULIUS_MBX_LEASE=str(lease),
                   YULIUS_MACRO_FREE=scratch, MBX_CACHE_DIR=str(cache),
                   MBX_GC_MAX_TOTAL_SIZE="16GiB", MBX_GC_INTERVAL="1m", MBX_TARGET_VIEWS="0",
                   MBX_RESTORE_HARDLINK="0", MBX_SCHEDULER="0", MBX_BUILD_SCRIPT_EXECUTION="0",
                   MBX_CC="0", MBX_SHARE_WORKSPACE_ROOT="0", MBX_SHARE_OUT_DIR="0",
                   MBX_LEARNED_INCREMENTAL="0", MBX_DISPLAY="plain", MBX_SUMMARY="full")
        try:
            status = run_build([mbx, *args], env, lease)
        except OSError as error:
            if marker.exists():
                raise RuntimeError(f"dispatched Cargo command failed: {error}") from error
            raise
        bypasses = sum(1 for _ in Path(scratch).glob("bypass.*"))
        if bypasses:
            print(f"yulius[cache]: {bypasses} compiler invocations bypassed for unknown or procedural-macro inputs",
                  file=sys.stderr)
        if marker.exists() or status < 0:
            sys.exit(status if status >= 0 else 128 - status)
except (OSError, KeyError, ValueError) as error:
    print(f"Rust compile cache unavailable ({error}); running Cargo directly", file=sys.stderr)
plain(cargo)
