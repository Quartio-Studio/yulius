{
    "name": "@vidocsecurity/code-context",
    "version": "0.0.94",
    "type": "module",
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "license": "UNLICENSED",
    "publishConfig": {
        "access": "restricted"
    },
    "exports": {
        ".": "./dist/esm/index.js",
        "./languages.yaml": "./languages.yaml",
        "./scan-target": "./dist/esm/files-lister/fileIgnore.js",
        "./utils/js": "./dist/esm/utils/js/index.js",
        "./utils/node": "./dist/esm/utils/node/index.js",
        "./utils/vidoc": "./dist/esm/utils/vidoc/index.js"
    },
    "files": [
        "dist",
        "languages.yaml"
    ],
    "typesVersions": {
        "*": {
            "index.d.ts": [
                "dist/esm/index.d.ts"
            ],
            "scan-target": [
                "dist/esm/files-lister/fileIgnore.d.ts"
            ],
            "utils/js": [
                "dist/esm/utils/js/index.d.ts"
            ],
            "utils/node": [
                "dist/esm/utils/node/index.d.ts"
            ],
            "utils/vidoc": [
                "dist/esm/utils/vidoc/index.d.ts"
            ]
        }
    },
    "scripts": {
        "lint": "eslint --ext .ts*",
        "watch": "tsc --watch -p tsconfig.release.json",
        "build": "rm -rf dist && tsc -p tsconfig.release.json",
        "test": "ENV=dev NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "ENV=dev NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "bench:getLanguageForPath": "bun src/scripts/bench.getLanguageForPath.ts"
    },
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.1",
        "@node-rs/crc32": "^1.10.6",
        "@vidocsecurity/api-client": "*",
        "@vscode/ripgrep": "1.18.0",
        "async-retry": "^1.3.3",
        "damerau-levenshtein": "1.0.8",
        "ignore": "^7.0.3",
        "ipaddr.js": "^2.3.0",
        "octokit": "^5.0.3",
        "p-limit": "^6.2.0",
        "proper-lockfile": "4.1.2",
        "semver": "^7.8.5",
        "undici": "^6.22.0",
        "vscode-ripgrep": "^1.13.2",
        "winston": "^3.17.0",
        "yaml": "^2.7.0"
    },
    "devDependencies": {
        "@types/async-retry": "^1.4.9",
        "@types/bun": "^1.1.15",
        "@types/damerau-levenshtein": "1.0.2",
        "@types/jest": "^29.2.5",
        "@types/node": "^20.5.6",
        "@types/proper-lockfile": "4.1.4",
        "@types/semver": "^7.8.0",
        "eslint": "^8.50.0",
        "jest": "^29.3.1",
        "ts-jest": "^29.0.3",
        "typescript": "^5.7.2"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
